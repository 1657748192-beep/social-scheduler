generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkspaceRole {
  owner
  admin
  editor
  viewer

  @@map("workspace_role")
}

enum InvitationStatus {
  pending
  accepted
  revoked
  expired

  @@map("invitation_status")
}

enum MemberStatus {
  active
  invited
  disabled

  @@map("member_status")
}

enum Platform {
  x
  instagram
  facebook
  tiktok
  linkedin
  youtube
  pinterest

  @@map("platform")
}

enum SocialAccountStatus {
  active
  disconnected
  token_expired
  authorization_invalid
  permission_missing

  @@map("social_account_status")
}

enum InstagramPrivateReplyStatus {
  pending
  sent
  failed

  @@map("instagram_private_reply_status")
}

enum PostStatus {
  draft
  in_review
  approved
  scheduled
  archived

  @@map("post_status")
}

enum PublishStatus {
  draft
  queued
  publishing
  published
  failed
  canceled

  @@map("publish_status")
}

enum ScheduleStatus {
  scheduled
  locked
  published
  failed
  canceled

  @@map("schedule_status")
}

enum JobStatus {
  waiting
  active
  succeeded
  retrying
  failed
  dead

  @@map("job_status")
}

model User {
  id           String            @id @default(uuid()) @db.Uuid
  email        String            @unique
  passwordHash String            @map("password_hash")
  name         String
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")
  publishingAccessDisabled Boolean @default(false) @map("publishing_access_disabled")
  publishingAccessExpiresAt DateTime? @map("publishing_access_expires_at")
  ownedSpaces  Workspace[]       @relation("WorkspaceOwner")
  memberships  WorkspaceMember[]
  posts        Post[]            @relation("PostAuthor")
  sessions     UserSession[]
  passwordResetTokens PasswordResetToken[]
  sentInvites  WorkspaceInvitation[] @relation("InvitationSender")
  acceptedInvites WorkspaceInvitation[] @relation("InvitationAccepter")
  oauthStates  OauthState[]
  tiktokSandboxCredentials TikTokSandboxCredential[]
  tiktokSandboxStates TikTokSandboxOAuthState[]
  oauthAuthorizationLinks OauthAuthorizationLink[] @relation("OauthAuthorizationLinkCreator")
  uploadedMedia MediaAsset[]     @relation("MediaUploader")
  localUploadSessions LocalUploadSession[]
  facebookManagementConnections FacebookManagementConnection[]
  facebookManagementStates FacebookManagementOAuthState[]

  instagramManagementConnections InstagramManagementConnection[]
  instagramManagementStates InstagramManagementOAuthState[]

  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt, expiresAt])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model UserSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenId   String    @unique @map("token_id")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@map("user_sessions")
}

model Workspace {
  id        String            @id @default(uuid()) @db.Uuid
  name      String
  slug      String            @unique
  timezone  String            @default("UTC")
  plan      String            @default("free")
  ownerId   String            @map("owner_id") @db.Uuid
  owner     User              @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")
  members   WorkspaceMember[]
  posts     Post[]
  invitations WorkspaceInvitation[]
  socialAccounts SocialAccount[]
  oauthStates OauthState[]
  tiktokSandboxCredentials TikTokSandboxCredential[]
  tiktokSandboxStates TikTokSandboxOAuthState[]
  oauthAuthorizationLinks OauthAuthorizationLink[]
  mediaAssets MediaAsset[]
  localUploadSessions LocalUploadSession[]
  facebookManagementConnections FacebookManagementConnection[]
  facebookManagementStates FacebookManagementOAuthState[]
  facebookManagementSelections FacebookManagementPageSelection[]
  interactionConnections InteractionConnection[]
  interactionAssets InteractionAsset[]
  interactionCustomers InteractionCustomer[]
  interactionTags InteractionTag[]
  interactionAudits InteractionAudit[]

  instagramManagementConnections InstagramManagementConnection[]
  instagramManagementStates InstagramManagementOAuthState[]
  metaInboxDeletionRequests MetaInboxDeletionRequest[]
  metaInboxDeletionMarkers MetaInboxDeletionMarker[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  role        WorkspaceRole @default(owner)
  status      MemberStatus  @default(active)
  createdAt   DateTime      @default(now()) @map("created_at")
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@map("workspace_members")
}

model WorkspaceInvitation {
  id           String           @id @default(uuid()) @db.Uuid
  workspaceId  String           @map("workspace_id") @db.Uuid
  email        String
  role         WorkspaceRole    @default(viewer)
  tokenHash    String           @unique @map("token_hash")
  status       InvitationStatus @default(pending)
  invitedById  String           @map("invited_by_id") @db.Uuid
  acceptedById String?          @map("accepted_by_id") @db.Uuid
  expiresAt    DateTime         @map("expires_at")
  acceptedAt   DateTime?        @map("accepted_at")
  createdAt    DateTime         @default(now()) @map("created_at")
  workspace    Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy    User             @relation("InvitationSender", fields: [invitedById], references: [id])
  acceptedBy   User?            @relation("InvitationAccepter", fields: [acceptedById], references: [id])

  @@index([workspaceId, status, createdAt])
  @@index([email, status])
  @@map("workspace_invitations")
}

model SocialAccount {
  id                String              @id @default(uuid()) @db.Uuid
  workspaceId       String              @map("workspace_id") @db.Uuid
  platform          Platform
  providerAccountId String              @map("provider_account_id")
  displayName       String              @map("display_name")
  avatarUrl         String?             @map("avatar_url")
  accountType       String?             @map("account_type")
  status            SocialAccountStatus @default(active)
  capabilities      Json                @default("{}")
  createdAt         DateTime            @default(now()) @map("created_at")
  workspace         Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  credential        OauthCredential?
  tiktokSandboxCredential TikTokSandboxCredential?
  tiktokSandboxStates TikTokSandboxOAuthState[]
  postVariants      PostVariant[]
  instagramPrivateReplyAttempts InstagramPrivateReplyAttempt[]
  instagramEngagementOAuthStates OauthState[] @relation("InstagramEngagementReauth")
  facebookEngagementOAuthStates OauthState[] @relation("FacebookEngagementReauth")
  facebookReceivedEvents FacebookReceivedEvent[]
  facebookReceivedComments FacebookReceivedComment[]
  facebookReceivedThreads FacebookReceivedThread[]
  facebookReceptionState FacebookReceptionState?
  instagramReceivedComments InstagramReceivedComment[]
  instagramReceivedThreads InstagramReceivedThread[]
  instagramReceptionState InstagramReceptionState?
  independentInstagramConnections InstagramManagementConnection[]

  @@unique([workspaceId, platform, providerAccountId])
  @@map("social_accounts")
}

model FacebookPageSubscriptionState {
  pageId String @id
  ownedFields String[]
  pendingRelease Boolean @default(false)
  releaseTokenEncrypted String?
  releaseExpiresAt DateTime?
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  @@map("facebook_page_subscription_states")
}

model FacebookReceivedEvent {
  id String @id @default(uuid()) @db.Uuid
  socialAccountId String @db.Uuid
  eventKey String
  payload Json?
  status String @default("pending")
  attempts Int @default(0)
  claimToken String?
  leaseUntil DateTime?
  nextAttemptAt DateTime @default(now())
  receivedAt DateTime @default(now())
  lastError String?
  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  @@unique([socialAccountId, eventKey])
  @@index([status, nextAttemptAt])
  @@map("facebook_received_events")
}

model FacebookReceivedComment {
  id String @id @default(uuid()) @db.Uuid
  socialAccountId String @db.Uuid
  providerCommentId String
  postId String
  text String?
  senderId String?
  senderName String?
  deleted Boolean @default(false)
  occurredAt DateTime
  receivedAt DateTime @default(now())
  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  @@unique([socialAccountId, providerCommentId])
  @@index([socialAccountId, postId, occurredAt])
  @@map("facebook_received_comments")
}

model FacebookReceivedThread {
  id String @id @default(uuid()) @db.Uuid
  socialAccountId String @db.Uuid
  counterpartyId String
  lastInboundAt DateTime?
  updatedAt DateTime @default(now())
  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  messages FacebookReceivedMessage[]
  @@unique([socialAccountId, counterpartyId])
  @@map("facebook_received_threads")
}

model FacebookReceivedMessage {
  id String @id @default(uuid()) @db.Uuid
  threadId String @db.Uuid
  providerMessageId String
  senderId String
  recipientId String
  text String?
  inbound Boolean
  occurredAt DateTime
  receivedAt DateTime @default(now())
  thread FacebookReceivedThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  @@unique([threadId, providerMessageId])
  @@index([receivedAt])
  @@map("facebook_received_messages")
}

model FacebookReceptionState {
  socialAccountId String @id @db.Uuid
  revision BigInt @default(0)
  lastReceivedAt DateTime?
  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  @@map("facebook_reception_states")
}

model InstagramReceivedComment {
  id String @id @default(uuid()) @db.Uuid
  socialAccountId String @db.Uuid
  providerCommentId String
  mediaId String
  text String?
  senderId String?
  username String?
  occurredAt DateTime
  receivedAt DateTime @default(now())
  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  @@unique([socialAccountId, providerCommentId])
  @@index([socialAccountId, mediaId, id])
  @@index([receivedAt])
  @@map("instagram_received_comments")
}

model InstagramReceivedThread {
  id String @id @default(uuid()) @db.Uuid
  socialAccountId String @db.Uuid
  counterpartyId String
  providerConversationId String?
  updatedAt DateTime @default(now())
  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  messages InstagramReceivedMessage[]
  @@unique([socialAccountId, counterpartyId])
  @@map("instagram_received_threads")
}

model InstagramReceivedMessage {
  id String @id @default(uuid()) @db.Uuid
  threadId String @db.Uuid
  providerMessageId String
  senderId String
  recipientId String
  text String?
  attachments Json @default("[]")
  inbound Boolean
  occurredAt DateTime
  receivedAt DateTime @default(now())
  thread InstagramReceivedThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  @@unique([threadId, providerMessageId])
  @@index([threadId, id])
  @@index([receivedAt])
  @@map("instagram_received_messages")
}

model InstagramReceptionState {
  socialAccountId String @id @db.Uuid
  revision BigInt @default(0)
  lastReceivedAt DateTime?
  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  @@map("instagram_reception_states")
}

model InstagramPrivateReplyAttempt {
  id                String                       @id @default(uuid()) @db.Uuid
  socialAccountId   String                       @map("social_account_id") @db.Uuid
  mediaId           String                       @map("media_id")
  commentId         String                       @map("comment_id")
  status            InstagramPrivateReplyStatus @default(pending)
  providerMessageId String?                      @map("provider_message_id")
  createdAt         DateTime                     @default(now()) @map("created_at")
  updatedAt         DateTime                     @updatedAt @map("updated_at")
  socialAccount     SocialAccount                @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@unique([socialAccountId, commentId])
  @@index([socialAccountId, mediaId, createdAt])
  @@map("instagram_private_reply_attempts")
}

model TikTokSandboxCredential {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  workspaceId String @db.Uuid
  socialAccountId String @unique @db.Uuid
  clientKey String
  openId String
  unionId String
  accessTokenEncrypted String
  refreshTokenEncrypted String?
  scopes String[]
  expiresAt DateTime
  refreshTokenExpiresAt DateTime?
  revision String @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  @@map("tiktok_sandbox_credentials")
}

model TikTokSandboxOAuthState {
  id String @id @default(uuid()) @db.Uuid
  stateHash String @unique
  userId String @db.Uuid
  workspaceId String @db.Uuid
  socialAccountId String @db.Uuid
  sessionId String @db.Uuid
  clientKey String
  expectedUnionId String
  redirectUri String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  @@index([expiresAt])
  @@map("tiktok_sandbox_oauth_states")
}

model OauthCredential {
  id                    String        @id @default(uuid()) @db.Uuid
  socialAccountId       String        @unique @map("social_account_id") @db.Uuid
  accessTokenEncrypted  String        @map("access_token_encrypted")
  refreshTokenEncrypted String?       @map("refresh_token_encrypted")
  tokenType             String        @default("Bearer") @map("token_type")
  scopes                String[]
  expiresAt             DateTime?     @map("expires_at")
  refreshTokenExpiresAt DateTime?     @map("refresh_token_expires_at")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")
  socialAccount         SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@map("oauth_credentials")
}

model OauthAuthorizationLink {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  platform    Platform
  tokenHash   String    @unique @map("token_hash")
  createdById String    @map("created_by_id") @db.Uuid
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  lastUsedAt  DateTime? @map("last_used_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   User      @relation("OauthAuthorizationLinkCreator", fields: [createdById], references: [id])
  oauthStates OauthState[]

  @@index([workspaceId, platform, expiresAt])
  @@map("oauth_authorization_links")
}

model OauthState {
  id           String    @id @default(uuid()) @db.Uuid
  workspaceId  String    @map("workspace_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  platform     Platform
  state        String    @unique
  authorizationLinkId String? @map("authorization_link_id") @db.Uuid
  instagramEngagementSocialAccountId String? @map("instagram_engagement_social_account_id") @db.Uuid
  facebookEngagementSocialAccountId String? @map("facebook_engagement_social_account_id") @db.Uuid
  facebookExpectedTokenHash String? @map("facebook_expected_token_hash")
  facebookExpectedPageId String? @map("facebook_expected_page_id")
  codeVerifier String?   @map("code_verifier")
  redirectUri  String    @map("redirect_uri")
  scopes       String[]
  expiresAt    DateTime  @map("expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  authorizationLink OauthAuthorizationLink? @relation(fields: [authorizationLinkId], references: [id], onDelete: SetNull)
  instagramEngagementSocialAccount SocialAccount? @relation("InstagramEngagementReauth", fields: [instagramEngagementSocialAccountId], references: [id], onDelete: Cascade)
  facebookEngagementSocialAccount SocialAccount? @relation("FacebookEngagementReauth", fields: [facebookEngagementSocialAccountId], references: [id], onDelete: Cascade)

  @@index([workspaceId, platform, createdAt])
  @@index([expiresAt])
  @@map("oauth_states")
}

model MediaAsset {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  uploadedBy  String   @map("uploaded_by") @db.Uuid
  fileUrl     String   @map("file_url")
  storageKey  String   @map("storage_key")
  thumbnailUrl String? @map("thumbnail_url")
  thumbnailStorageKey String? @map("thumbnail_storage_key")
  thumbnailSizeBytes Int? @map("thumbnail_size_bytes")
  mimeType    String   @map("mime_type")
  sizeBytes   Int      @map("size_bytes")
  width       Int?
  height      Int?
  durationSec Int?     @map("duration_sec")
  status      String   @default("ready")
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")
  originalDeletedAt DateTime? @map("original_deleted_at")
  thumbnailExpiresAt DateTime? @map("thumbnail_expires_at")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  uploader    User      @relation("MediaUploader", fields: [uploadedBy], references: [id])
  variantLinks PostVariantMedia[]
  localUploadSession LocalUploadSession?

  @@map("media_assets")
  @@index([status, thumbnailExpiresAt])
}

model LocalUploadSession {
  id                  String @id @default(uuid()) @db.Uuid
  userId              String @map("user_id") @db.Uuid
  workspaceId         String @map("workspace_id") @db.Uuid
  clientKey           String @map("client_key") @db.Uuid
  originalName        String @map("original_name")
  mimeType            String @map("mime_type")
  sizeBytes           Int @map("size_bytes")
  partHashes          String[] @map("part_hashes")
  fingerprint         String
  state               String @default("receiving")
  reservedBytes       Int @map("reserved_bytes")
  activityAt          DateTime @default(now()) @map("activity_at")
  expiresAt           DateTime @map("expires_at")
  mergeAttemptId      String? @map("merge_attempt_id") @db.Uuid
  mergeLeaseUntil     DateTime? @map("merge_lease_until")
  cleanupToken        String? @map("cleanup_token") @db.Uuid
  cleanupLeaseUntil   DateTime? @map("cleanup_lease_until")
  residueClearedAt    DateTime? @map("residue_cleared_at")
  mediaAssetId        String? @unique @map("media_asset_id") @db.Uuid
  thumbnailStorageKey String? @map("thumbnail_storage_key")
  thumbnailSizeBytes  Int? @map("thumbnail_size_bytes")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  user                User @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace           Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  mediaAsset          MediaAsset? @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  parts               LocalUploadPart[]

  @@unique([userId, workspaceId, clientKey])
  @@index([state, expiresAt])
  @@index([workspaceId, state])
  @@index([cleanupLeaseUntil, residueClearedAt])
  @@map("local_upload_sessions")
}

model LocalUploadPart {
  sessionId  String @map("session_id") @db.Uuid
  index      Int
  sizeBytes  Int @map("size_bytes")
  sha256     String
  storageKey String @unique @map("storage_key")
  createdAt  DateTime @default(now()) @map("created_at")
  session    LocalUploadSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@id([sessionId, index])
  @@map("local_upload_parts")
}

model FacebookManagementConnection {
  id String @id @default(uuid()) @db.Uuid
  appId String
  workspaceId String @db.Uuid
  userId String @db.Uuid
  providerUserId String
  userTokenEncrypted String?
  scopes String[]
  expiresAt DateTime?
  status String @default("active")
  version Int @default(1)
  directoryReadAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Cascade)
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  pages FacebookManagedPage[]
  @@index([workspaceId,status])
  @@map("facebook_management_connections")
}

model FacebookManagedPage {
  id String @id @default(uuid()) @db.Uuid
  connectionId String @db.Uuid
  pageId String
  name String
  profileUrl String?
  avatarUrl String?
  pageTokenEncrypted String?
  tasks String[]
  scopes String[]
  expiresAt DateTime?
  active Boolean @default(true)
  notificationsEnabled Boolean @default(false)
  lastReadAt DateTime?
  connection FacebookManagementConnection @relation(fields:[connectionId],references:[id],onDelete:Cascade)
  businesses FacebookManagedPageBusiness[]
  selections FacebookManagementPageSelection[]
  events FacebookInteractionEvent[]
  comments FacebookInteractionComment[]
  threads FacebookInteractionThread[]
  messages FacebookInteractionMessage[]
  sendAttempts FacebookInteractionSendAttempt[]
  @@unique([connectionId,pageId])
  @@index([pageId,active])
  @@map("facebook_managed_pages")
}

model FacebookManagedPageBusiness {
  id String @id @default(uuid()) @db.Uuid
  managedPageId String @db.Uuid
  businessId String
  name String
  relation String
  page FacebookManagedPage @relation(fields:[managedPageId],references:[id],onDelete:Cascade)
  @@unique([managedPageId,businessId,relation])
  @@map("facebook_managed_page_businesses")
}

model FacebookManagementOAuthState {
  id String @id @default(uuid()) @db.Uuid
  appId String
  state String @unique
  userId String @db.Uuid
  workspaceId String @db.Uuid
  sessionId String @db.Uuid
  callbackUrl String
  connectionId String? @db.Uuid
  connectionVersion Int?
  expiresAt DateTime
  consumedAt DateTime?
  completedAt DateTime?
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Cascade)
  @@index([expiresAt])
  @@map("facebook_management_oauth_states")
}

model FacebookManagementPageSelection {
  id String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  pageId String
  managedPageId String @db.Uuid
  workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Cascade)
  page FacebookManagedPage @relation(fields:[managedPageId],references:[id],onDelete:Cascade)
  @@unique([workspaceId,pageId])
  @@map("facebook_management_page_selections")
}

model FacebookManagementSubscription {
  id String @id @default(uuid()) @db.Uuid
  appId String
  pageId String
  fields String[]
  status String @default("unknown")
  checkedAt DateTime?
  diagnosticId String?
  @@unique([appId,pageId])
  @@map("facebook_management_subscriptions")
}

model FacebookInteractionEvent {
  id String @id @default(uuid()) @db.Uuid
  managedPageId String @db.Uuid
  eventKey String
  payload Json
  status String @default("pending")
  attempts Int @default(0)
  availableAt DateTime @default(now())
  leaseUntil DateTime?
  claimToken String?
  diagnosticId String?
  receivedAt DateTime @default(now())
  page FacebookManagedPage @relation(fields:[managedPageId],references:[id],onDelete:Cascade)
  @@unique([managedPageId,eventKey])
  @@index([status,availableAt,leaseUntil])
  @@index([receivedAt])
  @@map("facebook_interaction_events")
}

model FacebookInteractionComment {
  id String @id @default(uuid()) @db.Uuid
  managedPageId String @db.Uuid
  providerId String
  postId String
  parentId String?
  senderId String?
  senderName String?
  text String?
  deleted Boolean @default(false)
  occurredAt DateTime
  receivedAt DateTime @default(now())
  page FacebookManagedPage @relation(fields:[managedPageId],references:[id],onDelete:Cascade)
  @@unique([managedPageId,providerId])
  @@index([managedPageId,postId,occurredAt])
