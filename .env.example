NODE_ENV=development
API_PORT=4000
PUBLIC_API_URL=http://localhost:4000
API_PUBLIC_URL=http://localhost:4000
PUBLIC_WEB_URL=http://localhost:3000
WEB_APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=social_scheduler
DATABASE_URL=postgresql://app:change-me@postgres:5432/social_scheduler?schema=public
REDIS_URL=redis://redis:6379

JWT_SECRET=change-this-jwt-secret
JWT_EXPIRES_IN=30d
TOKEN_ENCRYPTION_KEY=change-this-32-character-key
ADMIN_EMAILS=admin@example.com

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@example.com
SMTP_PASS=your-app-password
SMTP_FROM="Social Scheduler <your-email@example.com>"

FACEBOOK_CLIENT_ID=your-facebook-app-id
FACEBOOK_CLIENT_SECRET=your-facebook-app-secret
FACEBOOK_LOGIN_CONFIG_ID=your-facebook-login-config-id
FACEBOOK_OAUTH_SCOPES=public_profile,pages_show_list,pages_read_engagement,pages_manage_posts

INSTAGRAM_CLIENT_ID=your-instagram-app-id
INSTAGRAM_CLIENT_SECRET=your-instagram-app-secret
INSTAGRAM_SCOPES=instagram_business_basic,instagram_business_content_publish
INSTAGRAM_OAUTH_SCOPES=instagram_business_basic,instagram_business_content_publish

YOUTUBE_CLIENT_ID=your-google-oauth-client-id
YOUTUBE_CLIENT_SECRET=your-google-oauth-client-secret
YOUTUBE_OAUTH_SCOPES=https://www.googleapis.com/auth/youtube.readonly,https://www.googleapis.com/auth/youtube.upload

LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
TIKTOK_CLIENT_ID=your-tiktok-client-id
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret
PINTEREST_CLIENT_ID=your-pinterest-client-id
PINTEREST_CLIENT_SECRET=your-pinterest-client-secret
X_CLIENT_ID=your-x-client-id
X_CLIENT_SECRET=your-x-client-secret
